<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/mc_bg" android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="커뮤니티" android:textColor="@color/mc_text" android:textSize="16sp" android:textStyle="bold" android:layout_weight="1" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/mc_line" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp" android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="함께 나누는 건강 일상" android:textColor="@color/mc_text" android:textSize="21sp" android:textStyle="bold" android:layout_marginBottom="5dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="서로의 경험을 공유하고 응원하세요." android:textColor="@color/mc_muted" android:textSize="11sp" />
                </LinearLayout>
                <Button android:layout_width="90dp" android:layout_height="42dp" android:layout_marginTop="0dp" android:layout_marginBottom="0dp" android:text="글쓰기" android:textAllCaps="false" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/mc_white" android:backgroundTint="@color/mc_primary" android:minHeight="0dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/mc_card_blue" android:layout_marginTop="0dp" android:layout_marginBottom="12dp" android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="이곳의 글은 개인의 경험입니다. 의학적 판단은 전문가와 상의하세요." android:textColor="@color/mc_muted" android:textSize="11sp" android:lineSpacingExtra="3dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="전체" android:textColor="@color/mc_primary" android:textSize="9sp" android:textStyle="bold" android:background="@drawable/mc_chip_mint" android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="5dp" android:paddingBottom="5dp" />
                <Space android:layout_width="5dp" android:layout_height="1dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="식사 이야기" android:textColor="@color/mc_muted" android:textSize="9sp" android:textStyle="bold" android:background="@drawable/mc_chip_gray" android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="5dp" android:paddingBottom="5dp" />
                <Space android:layout_width="5dp" android:layout_height="1dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="복약 경험" android:textColor="@color/mc_muted" android:textSize="9sp" android:textStyle="bold" android:background="@drawable/mc_chip_gray" android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="5dp" android:paddingBottom="5dp" />
                <Space android:layout_width="5dp" android:layout_height="1dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="생활 팁" android:textColor="@color/mc_muted" android:textSize="9sp" android:textStyle="bold" android:background="@drawable/mc_chip_gray" android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="5dp" android:paddingBottom="5dp" />
                <Space android:layout_width="5dp" android:layout_height="1dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp" android:layout_marginBottom="10dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="최근 이야기" android:textColor="@color/mc_text" android:textSize="16sp" android:textStyle="bold" android:layout_weight="1" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="최신순" android:textColor="@color/mc_primary" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/mc_card" android:layout_marginTop="0dp" android:layout_marginBottom="12dp" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="건강 정보" android:textColor="@color/mc_primary" android:textSize="10sp" android:textStyle="bold" android:background="@drawable/mc_chip_mint" android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="5dp" android:paddingBottom="5dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="가족과 기록을 나누니 확인이 쉬워졌어요" android:textColor="@color/mc_text" android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="9dp" android:layout_marginBottom="5dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="함께 기록을 확인하면서 하루를 정리하는 습관이 생겼습니다." android:textColor="@color/mc_muted" android:textSize="11sp" android:layout_marginBottom="10dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="김민 · 10:35                   댓글 2" android:textColor="@color/mc_muted" android:textSize="10sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/mc_card" android:layout_marginTop="0dp" android:layout_marginBottom="12dp" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="복약 이야기" android:textColor="@color/mc_primary" android:textSize="10sp" android:textStyle="bold" android:background="@drawable/mc_chip_mint" android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="5dp" android:paddingBottom="5dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="바쁜 아침에도 식사 기록은 남겨요" android:textColor="@color/mc_text" android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="9dp" android:layout_marginBottom="5dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="알림을 설정해 두니 챙겨야 할 일을 덜 놓치게 됩니다." android:textColor="@color/mc_muted" android:textSize="11sp" android:layout_marginBottom="10dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="이수민 · 12:40                 댓글 3" android:textColor="@color/mc_muted" android:textSize="10sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/mc_card" android:layout_marginTop="0dp" android:layout_marginBottom="12dp" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="생활 팁" android:textColor="@color/mc_primary" android:textSize="10sp" android:textStyle="bold" android:background="@drawable/mc_chip_mint" android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="5dp" android:paddingBottom="5dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="예시 하루 기록을 정리해 보았어요" android:textColor="@color/mc_text" android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="9dp" android:layout_marginBottom="5dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="복약과 식사 시간을 함께 기록하는 방법을 공유합니다." android:textColor="@color/mc_muted" android:textSize="11sp" android:layout_marginBottom="10dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="김지민 · 12:50                 댓글 1" android:textColor="@color/mc_muted" android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/mc_line" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal" android:background="@color/mc_white" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_weight="1" android:padding="4dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/mc_ic_home" android:tint="@color/mc_gray" android:contentDescription="home" android:layout_marginEnd="0dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="홈" android:textColor="@color/mc_muted" android:textSize="10sp" android:layout_marginTop="4dp" android:gravity="center" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_weight="1" android:padding="4dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/mc_ic_pill" android:tint="@color/mc_gray" android:contentDescription="pill" android:layout_marginEnd="0dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="복약 관리" android:textColor="@color/mc_muted" android:textSize="10sp" android:layout_marginTop="4dp" android:gravity="center" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_weight="1" android:padding="4dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/mc_ic_chat" android:tint="@color/mc_primary" android:contentDescription="chat" android:layout_marginEnd="0dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="커뮤니티" android:textColor="@color/mc_primary" android:textSize="10sp" android:textStyle="bold" android:layout_marginTop="4dp" android:gravity="center" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_weight="1" android:padding="4dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/mc_ic_calendar" android:tint="@color/mc_gray" android:contentDescription="calendar" android:layout_marginEnd="0dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="기록" android:textColor="@color/mc_muted" android:textSize="10sp" android:layout_marginTop="4dp" android:gravity="center" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>