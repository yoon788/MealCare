<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/mc_bg" android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="MealCare" android:textColor="@color/mc_text" android:textSize="16sp" android:textStyle="bold" android:layout_weight="1" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/mc_line" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
            <Space android:layout_width="1dp" android:layout_height="24dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="함께 챙기는&#10;식사와 복약 기록" android:textColor="@color/mc_text" android:textSize="27sp" android:textStyle="bold" android:layout_marginBottom="8dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="로그인하고 오늘의 기록을 확인하세요." android:textColor="@color/mc_muted" android:textSize="13sp" android:layout_marginBottom="23dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="이메일" android:textColor="@color/mc_muted" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="6dp" />
            <EditText android:id="@+id/etEmail" android:layout_width="match_parent" android:layout_height="52dp" android:background="@drawable/mc_field" android:paddingStart="14dp" android:paddingEnd="14dp" android:textSize="14sp" android:textColor="@color/mc_text" android:textColorHint="@color/mc_muted" android:hint="example@mealcare.com" android:inputType="textEmailAddress" android:gravity="center_vertical" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="비밀번호" android:textColor="@color/mc_muted" android:textSize="12sp" android:textStyle="bold" android:layout_marginTop="14dp" android:layout_marginBottom="6dp" />
            <EditText android:id="@+id/etPassword" android:layout_width="match_parent" android:layout_height="52dp" android:background="@drawable/mc_field" android:paddingStart="14dp" android:paddingEnd="14dp" android:textSize="14sp" android:textColor="@color/mc_text" android:textColorHint="@color/mc_muted" android:hint="비밀번호 입력" android:inputType="textPassword" android:gravity="center_vertical" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/mc_card_blue" android:layout_marginTop="18dp" android:layout_marginBottom="12dp" android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="한 번 로그인하면 다음부터는 자동으로 로그인됩니다." android:textColor="@color/mc_muted" android:textSize="11sp" android:lineSpacingExtra="3dp" />
            </LinearLayout>
            <Space android:layout_width="1dp" android:layout_height="12dp" />
            <Button android:id="@+id/btnLogin" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="8dp" android:text="로그인" android:textAllCaps="false" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/mc_white" android:backgroundTint="@color/mc_primary" android:minHeight="0dp" />
            <Button android:id="@+id/btnGoSignUp" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="8dp" android:text="처음이에요 · 회원가입" android:textAllCaps="false" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/mc_primary" android:backgroundTint="@color/mc_primary_soft" android:minHeight="0dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
