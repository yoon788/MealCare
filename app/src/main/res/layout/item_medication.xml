<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/mc_card" android:layout_marginBottom="12dp" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/mc_ic_pill" android:tint="@color/mc_primary" android:contentDescription="pill" android:layout_marginEnd="8dp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
            <TextView android:id="@+id/tvName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="약 이름" android:textColor="@color/mc_text" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvCondition" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="아침 식후 30분" android:textColor="@color/mc_muted" android:textSize="11sp" android:layout_marginTop="5dp" />
        </LinearLayout>
        <TextView android:id="@+id/tvStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="예정" android:textColor="@color/mc_muted" android:textSize="10sp" android:textStyle="bold" android:background="@drawable/mc_chip_gray" android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="5dp" android:paddingBottom="5dp" />
    </LinearLayout>
    <Space android:layout_width="1dp" android:layout_height="12dp" />
    <TextView android:id="@+id/tvTimeInfo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="08:30   식후 30분   식사 08:00" android:textColor="@color/mc_muted" android:textSize="11sp" />
    <TextView android:id="@+id/tvTake" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▶ 복용 완료로 기록" android:textColor="@color/mc_primary" android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="8dp" android:paddingTop="4dp" android:paddingBottom="4dp" />
</LinearLayout>