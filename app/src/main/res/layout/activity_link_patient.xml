<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/mc_bg" android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
        <ImageView android:layout_width="21dp" android:layout_height="21dp" android:src="@drawable/mc_ic_back" android:tint="@color/mc_dark" android:id="@+id/btnBack" android:contentDescription="back" android:layout_marginEnd="14dp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="초대 코드 입력" android:textColor="@color/mc_text" android:textSize="16sp" android:textStyle="bold" android:layout_weight="1" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/mc_line" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
            <Space android:layout_width="1dp" android:layout_height="14dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="가족의 기록을 함께 확인해요" android:textColor="@color/mc_text" android:textSize="22sp" android:textStyle="bold" android:layout_marginBottom="7dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="환자로부터 받은 초대 코드를 입력하면 기록을 확인하고 필요한 도움을 제공할 수 있습니다." android:textColor="@color/mc_muted" android:textSize="12sp" android:layout_marginBottom="18dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="초대 코드" android:textColor="@color/mc_muted" android:textSize="12sp" android:textStyle="bold" android:layout_marginTop="0dp" android:layout_marginBottom="6dp" />
            <EditText android:layout_width="match_parent" android:layout_height="52dp" android:background="@drawable/mc_field" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:textSize="14sp" android:textColor="@color/mc_text" android:textColorHint="@color/mc_muted" android:id="@+id/etCode" android:maxLength="6" android:hint="예: MC4821" android:layout_marginTop="0dp" android:inputType="textCapCharacters|textNoSuggestions" android:gravity="center_vertical" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/tvCodeHelp" android:text="코드는 영문과 숫자로 구성되어 있습니다." android:textColor="@color/mc_primary" android:textSize="11sp" android:layout_marginTop="8dp" android:layout_marginBottom="15dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp" android:layout_marginBottom="10dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:id="@+id/tvPatientTitle" android:visibility="gone" android:text="연결할 환자" android:textColor="@color/mc_text" android:textSize="16sp" android:textStyle="bold" android:layout_weight="1" />
            </LinearLayout>
            <LinearLayout android:id="@+id/cardPatient" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/mc_card" android:layout_marginTop="0dp" android:layout_marginBottom="8dp" android:padding="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/mc_icon_tile" android:padding="8dp">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/mc_ic_user" android:tint="@color/mc_primary" android:contentDescription="user" android:layout_marginEnd="0dp" />
                    </LinearLayout>
                    <Space android:layout_width="11dp" android:layout_height="1dp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/tvPatientName" android:text="김지민 환자" android:textColor="@color/mc_text" android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="4dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="연결 가능한 환자 · 식사와 복약 기록" android:textColor="@color/mc_muted" android:textSize="11sp" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="연결 가능" android:textColor="@color/mc_primary" android:textSize="10sp" android:textStyle="bold" android:background="@drawable/mc_chip_mint" android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="5dp" android:paddingBottom="5dp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp" android:layout_marginBottom="10dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="연결 후 확인할 수 있는 기록" android:textColor="@color/mc_text" android:textSize="16sp" android:textStyle="bold" android:layout_weight="1" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/mc_card" android:layout_marginTop="0dp" android:layout_marginBottom="12dp" android:padding="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                    <CheckBox android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:buttonTint="@color/mc_primary" android:text="식사 기록" android:textSize="13sp" android:textColor="@color/mc_text" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="식사 완료 및 결식 상태를 확인할 수 있습니다." android:textColor="@color/mc_muted" android:textSize="11sp" android:layout_marginBottom="8dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                    <CheckBox android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:buttonTint="@color/mc_primary" android:text="복약 기록" android:textSize="13sp" android:textColor="@color/mc_text" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="복용 완료 및 미확인 상태를 확인할 수 있습니다." android:textColor="@color/mc_muted" android:textSize="11sp" android:layout_marginBottom="8dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                    <CheckBox android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:buttonTint="@color/mc_primary" android:text="환자의 일정" android:textSize="13sp" android:textColor="@color/mc_text" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="식사 및 복약 알림 시간을 확인할 수 있습니다." android:textColor="@color/mc_muted" android:textSize="11sp" android:layout_marginBottom="8dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/mc_card_blue" android:layout_marginTop="0dp" android:layout_marginBottom="12dp" android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="환자의 동의와 공유 범위에 따라 일부 정보가 제한될 수 있습니다." android:textColor="@color/mc_muted" android:textSize="11sp" android:lineSpacingExtra="3dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/mc_bg" android:padding="14dp">
        <Button android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="0dp" android:layout_marginBottom="0dp" android:id="@+id/btnConnect" android:text="코드 확인" android:textAllCaps="false" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/mc_white" android:backgroundTint="@color/mc_primary" android:minHeight="0dp" />
    </LinearLayout>
</LinearLayout>